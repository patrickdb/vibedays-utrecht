{
  "name": "todo-cat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build --workspace cli",
    "prepare": "npm run build --workspace cli",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:chat": "playwright test --config playwright.chat.config.ts",
    "typecheck": "next typegen && tsc --noEmit && npm run typecheck --workspaces --if-present",
    "qa": "bash scripts/qa.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reset": "node scripts/db-reset.mjs",
    "db:seed": "tsx --conditions react-server scripts/db-seed.ts",
    "lint": "biome check",
    "format": "biome format --write"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.1",
    "@ag-ui/core": "1.0.1",
    "@ag-ui/mastra": "1.1.6",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@copilotkit/a2ui-renderer": "1.77.0",
    "@copilotkit/react-core": "1.77.0",
    "@copilotkit/runtime": "1.77.0",
    "@libsql/client": "^0.18.0",
    "@mastra/core": "1.74.0",
    "@mastra/libsql": "1.25.0",
    "@mastra/memory": "1.35.0",
    "better-auth": "1.7.7",
    "drizzle-orm": "^1.0.0-rc.4",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rxjs": "7.8.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@a2ui/web_core": "0.10.4",
    "@ag-ui/a2ui-middleware": "0.0.10",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^1.0.0-rc.4",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "workspaces": [
    "contract",
    "cli"
  ]
}
